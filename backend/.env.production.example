# Plantilla de referencia para producción — NO es un .env real, no tiene
# valores reales. Copiar a `.env.production` (ya está en .gitignore) y
# completar cada __REEMPLAZAR__ con un gestor de secretos (nunca commitear
# el archivo con valores reales).

APP_NAME="Biblioteca UMAG"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=__REEMPLAZAR__
APP_TIMEZONE=America/Punta_Arenas

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=__REEMPLAZAR__
DB_PORT=5432
DB_DATABASE=__REEMPLAZAR__
DB_USERNAME=__REEMPLAZAR__
DB_PASSWORD=__REEMPLAZAR__
DB_SSLMODE=require

FRONTEND_URL=__REEMPLAZAR__
SANCTUM_STATEFUL_DOMAINS=__REEMPLAZAR__
SESSION_DOMAIN=__REEMPLAZAR__
SANCTUM_TOKEN_EXPIRATION=480

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
